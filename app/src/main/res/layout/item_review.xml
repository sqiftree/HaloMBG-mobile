<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="6dp"
    app:cardBackgroundColor="@color/surface_1"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewSchool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SD Negeri 1 Jaya"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewAuthorDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahmad Dani · 2026-06-10"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status flag badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewFlagBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardBackgroundColor="#FFF8E1"
                app:cardElevation="0dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="⚑ Dilaporkan"
                    android:textColor="@color/status_warning"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnReviewAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/status_error"
                android:text="Hapus"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Makanannya sangat enak dan gurih. Semua anak suka."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
