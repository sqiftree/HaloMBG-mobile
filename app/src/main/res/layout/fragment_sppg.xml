<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_2">

    <!-- Segmented Tab Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface_1"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnTabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="Kelola Menu"
            android:textColor="@color/primary_navy"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabDistribusi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="Pengiriman Sekolah"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Scrollable container for forms/list -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ================= VIEW 1: KELOLA MENU ================= -->
            <LinearLayout
                android:id="@+id/layoutSppgMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INPUT MENU HARIAN"
                    android:textColor="@color/primary_navy"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="6dp"
                    app:cardBackgroundColor="@color/surface_1"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Menu Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nama Menu Makanan"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="6dp"
                            app:strokeColor="@color/border_default"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp">
                            <EditText
                                android:id="@+id/etSppgMenuName"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@null"
                                android:paddingHorizontal="12dp"
                                android:hint="Misal: Nasi &amp; Ayam Panggang Madu"
                                android:inputType="text"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary"
                                android:textSize="13sp"
                                android:importantForAutofill="no" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Components -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Komponen Makanan (Koma terpisah)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="6dp"
                            app:strokeColor="@color/border_default"
                            app:strokeWidth="1dp"
                            app:cardElevation="0dp">
                            <EditText
                                android:id="@+id/etSppgMenuComponents"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:background="@null"
                                android:gravity="top"
                                android:padding="10dp"
                                android:hint="Nasi Putih, Fillet Ayam Panggang, Sayur Buncis, Susu Kotak"
                                android:inputType="textMultiLine"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary"
                                android:textSize="13sp"
                                android:importantForAutofill="no" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Macros Input -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Klaim Nilai Gizi"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:columnCount="2"
                            android:rowCount="2"
                            android:alignmentMode="alignMargins">

                            <!-- Calories -->
                            <LinearLayout
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Kalori (kkal)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11dp" />
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="4dp"
                                    app:cardCornerRadius="6dp"
                                    app:strokeColor="@color/border_default"
                                    app:strokeWidth="1dp"
                                    app:cardElevation="0dp">
                                    <EditText
                                        android:id="@+id/etSppgCalories"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="8dp"
                                        android:inputType="number"
                                        android:hint="640"
                                        android:textSize="12sp"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                            <!-- Protein -->
                            <LinearLayout
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Protein (gram)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11dp" />
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="4dp"
                                    app:cardCornerRadius="6dp"
                                    app:strokeColor="@color/border_default"
                                    app:strokeWidth="1dp"
                                    app:cardElevation="0dp">
                                    <EditText
                                        android:id="@+id/etSppgProtein"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="8dp"
                                        android:inputType="number"
                                        android:hint="25"
                                        android:textSize="12sp"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                            <!-- Carbs -->
                            <LinearLayout
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginEnd="12dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Karbohidrat (gram)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11dp" />
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="4dp"
                                    app:cardCornerRadius="6dp"
                                    app:strokeColor="@color/border_default"
                                    app:strokeWidth="1dp"
                                    app:cardElevation="0dp">
                                    <EditText
                                        android:id="@+id/etSppgCarbs"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="8dp"
                                        android:inputType="number"
                                        android:hint="82"
                                        android:textSize="12sp"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                            <!-- Fat -->
                            <LinearLayout
                                android:layout_width="140dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lemak (gram)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11dp" />
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="4dp"
                                    app:cardCornerRadius="6dp"
                                    app:strokeColor="@color/border_default"
                                    app:strokeWidth="1dp"
                                    app:cardElevation="0dp">
                                    <EditText
                                        android:id="@+id/etSppgFat"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="8dp"
                                        android:inputType="number"
                                        android:hint="14"
                                        android:textSize="12sp"
                                        android:importantForAutofill="no" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                        </GridLayout>

                        <!-- Simulated AI validation triggers -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnSppgSelectPhoto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/surface_2"
                                android:text="Unggah Foto"
                                android:textColor="@color/text_primary"
                                app:strokeColor="@color/border_default"
                                app:strokeWidth="1dp"
                                app:cornerRadius="6dp" />

                            <TextView
                                android:id="@+id/tvSppgPhotoStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Belum ada foto"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSppgAiValidate"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:backgroundTint="@color/accent_pastel_blue"
                            android:text="Validasi Gizi Berbasis AI ✦"
                            android:textColor="@color/primary_navy"
                            android:textStyle="bold"
                            app:cornerRadius="6dp" />

                        <TextView
                            android:id="@+id/tvSppgAiStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Status AI: Belum divalidasi"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                        <!-- Save button -->
                        <Button
                            android:id="@+id/btnSppgSaveMenu"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="20dp"
                            android:backgroundTint="@color/primary_navy"
                            android:text="Simpan Menu Harian"
                            android:textColor="@color/surface_1"
                            app:cornerRadius="6dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================= VIEW 2: STATUS DISTRIBUSI ================= -->
            <LinearLayout
                android:id="@+id/layoutSppgDistribusi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS PENGIRIMAN SEKOLAH"
                    android:textColor="@color/primary_navy"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <!-- RecyclerView for schools status -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSppgSchools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:listitem="@layout/item_distribution"
                    tools:itemCount="3" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
