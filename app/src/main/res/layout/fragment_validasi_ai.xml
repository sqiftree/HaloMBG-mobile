<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_width"
            android:layout_height="wrap_content"
            android:text="VALIDASI AI KELAYAKAN GIZI"
            android:textColor="@color/primary_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pindai porsi makanan dengan kamera untuk memvalidasi standar gizi makro harian program MBG."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Camera / Workspace Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/surface_1"
            app:strokeColor="@color/border_default"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Viewport Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@color/surface_2">

                    <!-- Camera Placeholder or simulated view -->
                    <LinearLayout
                        android:id="@+id/layoutAiCameraPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Kamera belum aktif"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Gunakan kamera simulasi di bawah untuk menguji."
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Camera Simulation Active Frame -->
                    <LinearLayout
                        android:id="@+id/layoutAiCameraActive"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@color/primary_navy"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/secondary_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="SIMULASI KAMERA AKTIF ✦"
                            android:textColor="@color/secondary_green"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mendeteksi porsi: Nasi, Ayam Panggang, Sayur Buncis"
                            android:textColor="@color/surface_3"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Validation Loading overlay -->
                    <LinearLayout
                        android:id="@+id/layoutAiScanning"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#D8071E49"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminateTint="@color/secondary_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Menganalisis Makanan Menggunakan AI..."
                            android:textColor="@color/surface_1"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Scan Line animation holder (top line) -->
                    <View
                        android:id="@+id/viewScanLine"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/secondary_green"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnAiOpenSimulate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_navy"
                        android:text="Kamera Simulasi"
                        android:textColor="@color/surface_1"
                        app:cornerRadius="6dp" />

                    <Button
                        android:id="@+id/btnAiCapture"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/secondary_green"
                        android:text="Ambil &amp; Validasi"
                        android:textColor="@color/primary_navy"
                        android:visibility="gone"
                        app:cornerRadius="6dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/surface_1"
            app:strokeColor="@color/border_default"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Status badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="4dp"
                        app:cardBackgroundColor="#E8F5E9"
                        app:cardElevation="0dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="TERVALIDASI"
                            android:textColor="@color/status_success"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Akurasi AI: 96.4%"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAiResultSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Menu memenuhi standar kecukupan nutrisi program MBG dengan gizi makro lengkap dan serat seimbang."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <!-- Macros Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <!-- Calories -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvAiValCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="640"
                            android:textColor="@color/primary_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kalori (kkal)"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Protein -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvAiValProtein"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25g"
                            android:textColor="@color/primary_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protein"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Carbs -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvAiValCarbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82g"
                            android:textColor="@color/primary_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karbo"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Fat -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvAiValFat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14g"
                            android:textColor="@color/primary_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lemak"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Food tags list title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Komposisi Bahan Terdeteksi:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Food tags list content -->
                <TextView
                    android:id="@+id/tvAiResultFoodTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nasi Putih · Fillet Ayam Panggang · Cah Wortel &amp; Buncis · Susu Kotak UHT · Melon"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAiSaveLog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_navy"
                        android:text="Simpan Log Validasi"
                        android:textColor="@color/surface_1"
                        app:cornerRadius="6dp" />

                    <Button
                        android:id="@+id/btnAiReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:text="Hapus Hasil"
                        android:textColor="@color/status_error" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Validation History Log Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RIWAYAT VALIDASI TERBARU"
            android:textColor="@color/primary_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <!-- Simple History Table Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/surface_1"
            app:strokeColor="@color/border_default"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/layoutAiHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
