<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Today's Menu Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU HARI INI"
            android:textColor="@color/primary_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/surface_1"
            app:strokeColor="@color/border_default"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSiswaMenuName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nasi &amp; Ayam Panggang Madu"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSiswaMenuComponents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Komponen: Nasi Putih, Fillet Ayam Panggang, Cah Wortel &amp; Buncis, Susu Kotak UHT, Potongan Melon"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Macros Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvSiswaCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="640"
                            android:textColor="@color/primary_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kalori"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvSiswaProtein"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25g"
                            android:textColor="@color/primary_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protein"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvSiswaCarbs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82g"
                            android:textColor="@color/primary_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karbo"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvSiswaFat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14g"
                            android:textColor="@color/primary_navy"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lemak"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSiswaKitchenLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Disediakan oleh: Dapur Sehat Kartasura"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Send Review Form -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="KIRIM ULASAN HARIAN"
            android:textColor="@color/primary_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="@color/surface_1"
            app:strokeColor="@color/border_default"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ulasan Anda"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="6dp"
                    app:cardBackgroundColor="@color/surface_1"
                    app:strokeColor="@color/border_default"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etReviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@null"
                        android:gravity="top|start"
                        android:padding="10dp"
                        android:hint="Ceritakan pengalaman makan bergizi gratis hari ini. Apakah rasanya enak? Apakah porsinya cukup?"
                        android:inputType="textMultiLine"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="13sp"
                        android:importantForAutofill="no" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Photo Upload Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSiswaSelectPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/surface_2"
                        android:text="Pilih Foto"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/border_default"
                        app:strokeWidth="1dp"
                        app:cornerRadius="6dp" />

                    <TextView
                        android:id="@+id/tvSiswaPhotoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Belum ada foto terpilih"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSiswaSubmitReview"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/primary_navy"
                    android:text="Kirim Ulasan"
                    android:textColor="@color/surface_1"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reviews History List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RIWAYAT ULASAN SAYA"
            android:textColor="@color/primary_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSiswaReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:listitem="@layout/item_review"
            tools:itemCount="2" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
